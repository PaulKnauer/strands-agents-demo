# --- LLM Configuration ---
# Provider: "bedrock" (Amazon Bedrock) or "gemini" (Google Gemini)
MODEL_PROVIDER=bedrock

# Model ID — Bedrock: "anthropic.claude-3-haiku-20240307-v1:0"
#           — Gemini: "gemini-2.0-flash"
MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- AWS Configuration (required for Bedrock and AgentCore deployment) ---
# AWS region for Bedrock API calls and AgentCore deployment
AWS_REGION=us-east-1

# --- AgentCore Deployment ---
# The deployed runtime (deploy/app.py) uses Bedrock Converse directly — MODEL_PROVIDER=bedrock required for deployment
# Name for your agent in AgentCore (used for idempotency check)
AGENT_NAME=age-in-days-demo

# --- Bedrock Guardrails (optional — Bedrock provider only) ---
# Provision via: aws cloudformation deploy --template-file deploy/guardrail.yaml --stack-name strands-demo-guardrail
# Then retrieve GuardrailId from the stack outputs and set GUARDRAIL_ID below.
# When unset, the agent runs without content filtering (suitable for local development).
# NIST AI RMF: MANAGE-2.2 (harmful content), MANAGE-1.3 (PII), GOVERN-1.1 (prompt injection)
# GUARDRAIL_ID=your-guardrail-id-here
# GUARDRAIL_VERSION=DRAFT

# --- GitHub Actions Redteam CI ---
# Provision the short-lived OIDC role via: make redteam-role
# Then set the GitHub repository secret AWS_ROLE_TO_ASSUME to the emitted role ARN.
# Do not create long-lived AWS access key repository secrets for CI.

# --- Optional: Google Gemini (only if MODEL_PROVIDER=gemini) ---
# Your Google AI Studio API key (required when MODEL_PROVIDER=gemini)
# GOOGLE_API_KEY=your-gemini-api-key-here
