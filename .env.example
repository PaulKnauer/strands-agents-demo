# --- LLM Configuration ---
# Provider: "bedrock" (Amazon Bedrock), "llama" (Meta Llama via Bedrock),
#           "gemini" (local-only Google Gemini), or "litellm" (local-only exploratory direct-provider evaluation)
MODEL_PROVIDER=bedrock

# Model ID — Bedrock: "us.amazon.nova-micro-v1:0"
#           — Gemini: "gemini-2.0-flash"
#           — Llama:  "us.meta.llama3-1-70b-instruct-v1:0"
MODEL_ID=us.amazon.nova-micro-v1:0
# Supported Bedrock-backed alias (Story 4.3 rollout — requires Bedrock model access):
# MODEL_PROVIDER=llama
# MODEL_ID=us.meta.llama3-1-70b-instruct-v1:0
# Note: MODEL_PROVIDER=llama routes through Amazon Bedrock Converse — not a direct Meta API.
#       Single-region alternative: MODEL_ID=meta.llama3-1-70b-instruct-v1:0 (us-west-2 only).
# Planned additions (not yet enabled): Gemma, Moonshot/Kimi, Qwen, and DeepSeek via Amazon Bedrock — staged Epic 4 expansion.
# Setting MODEL_PROVIDER to any of these names today will fail explicitly; local adapter selection raises ValueError.

# --- AWS Configuration (required for Bedrock and AgentCore deployment) ---
# AWS region for Bedrock API calls and AgentCore deployment
AWS_REGION=us-east-1

# --- AgentCore Deployment ---
# The deployed runtime (deploy/app.py) uses Bedrock Converse directly — MODEL_PROVIDER=bedrock or MODEL_PROVIDER=llama required for deployment
# Name for your agent in AgentCore (used for idempotency check)
AGENT_NAME=age-in-days-demo

# --- Bedrock Guardrails (optional — Bedrock provider only) ---
# Provision via: aws cloudformation deploy --template-file deploy/guardrail.yaml --stack-name strands-demo-guardrail
# Then retrieve GuardrailId from the stack outputs and set GUARDRAIL_ID below.
# When unset, the agent runs without content filtering (suitable for local development).
# NIST AI RMF: MANAGE-2.2 (harmful content), MANAGE-1.3 (PII), GOVERN-1.1 (prompt injection)
# GUARDRAIL_ID=your-guardrail-id-here
# GUARDRAIL_VERSION=DRAFT

# --- GitHub Actions Redteam CI ---
# Provision the short-lived OIDC role via: make redteam-role
# Then set the GitHub repository secret AWS_ROLE_TO_ASSUME to the emitted role ARN.
# Do not create long-lived AWS access key repository secrets for CI.

# --- Optional: Google Gemini (only if MODEL_PROVIDER=gemini) ---
# Your Google AI Studio API key (required when MODEL_PROVIDER=gemini)
# GOOGLE_API_KEY=your-gemini-api-key-here

# --- Optional: LiteLLM direct-provider evaluation (local-only, exploratory) ---
# This path is NOT deployable through AgentCore. It is an evaluation boundary (Story 4.4),
# not a production-aligned alternative to the Bedrock-first path.
# Requires: pip install 'strands-agents[litellm]'
# Extra burden: provider-specific secrets, outbound networking, wider test matrix.
#
# Example: Kimi (Moonshot) via LiteLLM — OpenAI-compatible API
# MODEL_PROVIDER=litellm
# MODEL_ID=moonshot/moonshot-v1-8k
# MOONSHOT_API_KEY=your-moonshot-api-key-here
# LITELLM_API_BASE=https://api.moonshot.ai/v1
#
# For other OpenAI-compatible providers, set provider-specific credentials and
# override LITELLM_API_BASE to that provider's endpoint.
